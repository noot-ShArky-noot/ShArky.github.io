{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C program",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "F:/MSYS2/ucrt64/bin/gdb.exe",
            "preLaunchTask": "build C",

            "environment": [
                {
                    "name": "LC_ALL",
                    "value": "C"
                }
            ],

            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}